{
  "manifest_version": 3,
  "name": "Strands Browser Agent",
  "description": "Run AI agents powered by Strands SDK directly in your browser",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
