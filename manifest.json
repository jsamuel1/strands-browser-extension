{
  "manifest_version": 3,
  "name": "Strands Browser Control Agent",
  "version": "1.0.0",
  "description": "Comprehensive browser control tool for Strands Agent with navigation, content extraction, DOM interaction, and screenshots",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Strands Browser Agent"
  },
  "web_accessible_resources": [
    {
      "resources": ["content-script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}