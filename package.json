{
  "name": "03-browser-agent",
  "version": "1.0.0",
  "description": "Run Strands Agents in the browser with Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build && node scripts/post-build.js",
    "preview": "vite preview",
    "build:extension": "vite build && node scripts/post-build.js",
    "dev:extension": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@strands-agents/sdk": "github:strands-agents/sdk-typescript",
    "marked": "^17.0.1",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "eslint": "^8.57.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^23.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.15"
  }
}
