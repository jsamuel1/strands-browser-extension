# Strands Browser Agent - Environment Variables Example
# 
# IMPORTANT: This file contains example values only. Copy this file to .env
# and replace with your actual credentials. Never commit .env to the repository!
#
# Note: For the browser extension, credentials are entered via the UI, not 
# environment variables. These examples are provided for reference only.

# AWS Bedrock Configuration (Example only - DO NOT use these values)
# Credentials should be entered in the extension UI or stored in ~/.aws/
#AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#AWS_SESSION_TOKEN=FwoGZXIvYXdzEEXAMPLE...EXAMPLETOKEN
#AWS_REGION=us-east-1

# OpenAI Configuration (Example only - DO NOT use these values)
# Credentials should be entered in the extension UI
#OPENAI_API_KEY=sk-proj-EXAMPLE1234567890abcdefghijklmnopqrstuvwxyz

# Development settings
#NODE_ENV=development
#VITE_API_TIMEOUT=30000
